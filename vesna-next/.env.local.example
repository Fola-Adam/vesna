# ============================================
# VESNA - Environment Variables Template
# Copy this file to .env.local and fill in your values
# ============================================

# Supabase Configuration
# Get these from your Supabase project dashboard: https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq API (for Venus AI chat)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk-your-api-key

# Brevo (Sendinblue) Email API
# Get from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://vesna.ng
NEXT_PUBLIC_SITE_NAME=Vesna

# Admin Email (for Victory's account)
ADMIN_EMAIL=victory@vesna.ng
