# Supabase (required for auth, database, admin panel)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: required to persist newsletter signup while public RLS stays closed
SUPABASE_SERVICE_ROLE_KEY=

# Groq (required for Venus AI chat assistant)
GROQ_API_KEY=
# Brevo (optional — newsletter sync; signups still save to Supabase without it)
BREVO_API_KEY=

# Optional newsletter delivery automation
BREVO_LIST_ID=

# Public identity (defaults match the existing app)
NEXT_PUBLIC_SITE_URL=https://vesna-seven.vercel.app
NEXT_PUBLIC_CONTACT_EMAIL=victoryvesna2@gmail.com

# Optional semantic lookup; leave off unless vector search/model cache is provisioned
VENUS_SEMANTIC_SEARCH=false
